/* ── Power Menu Theme ─────────────────────────────────────────
   Neon Teal — matches Waybar/Hyprland #00ffb3 accent
   Uses 8-digit hex (#rrggbbaa) — required for Rofi 2.0
   ──────────────────────────────────────────────────────────── */

* {
    font:             "JetBrainsMono Nerd Font Bold 12";
    background-color: transparent;
    text-color:       #ffffff;

    /* ── colour tokens ── */
    bg-base:          #000000fa;       /* pure black, 98% opaque  */
    accent:           #00ffb3ff;       /* neon teal, full opaque   */
    accent-dim:       #00ffb30a;       /* teal tint  ~4%           */
    accent-mid:       #00ffb32e;       /* teal tint ~18%           */
    accent-hover:     #00ffb34d;       /* teal tint ~30%           */
    border-subtle:    #00ffb333;       /* subtle border ~20%       */
}

window {
    transparency:     "real";
    background-color: @bg-base;
    border:           2px solid;
    border-color:     @accent;
    border-radius:    14px;
    width:            220px;
    location:         northeast;
    x-offset:         -10px;
    y-offset:         45px;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
    padding:          10px 8px;
    spacing:          0px;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            5;
    spacing:          5px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        false;
}

element {
    background-color: @accent-dim;
    border:           1px solid;
    border-color:     @border-subtle;
    text-color:       #ffffff;
    border-radius:    8px;
    padding:          9px 14px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

element normal.normal {
    background-color: @accent-dim;
    text-color:       #ffffff;
}

element alternate.normal {
    background-color: @accent-dim;
    text-color:       #ffffff;
}

element selected.normal {
    background-color: @accent;
    text-color:       #000000ff;
    border:           1px solid;
    border-color:     @accent;
}
