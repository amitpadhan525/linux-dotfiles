/* ── Power Menu Theme ─────────────────────────────────────────
   Neon Teal — matches Waybar/Hyprland #00ffb3 accent
   Uses 8-digit hex (#rrggbbaa) — required for Rofi 2.0
   ──────────────────────────────────────────────────────────── */

@import "colors.rasi"

* {
    font:             "JetBrainsMono Nerd Font Bold 12";
    background-color: transparent;
    text-color:       @fg-main;
}

window {
    transparency:     "real";
    background-color: @bg-base-solid;
    border:           1px solid;
    border-color:     @accent-soft;
    border-radius:    22px;
    width:            220px;
    location:         center;
    anchor:           center;
    x-offset:         0;
    y-offset:         0;
}

mainbox {
    background-color: transparent;
    children:         [ listview ];
    padding:          10px 8px;
    spacing:          0px;
}

listview {
    background-color: transparent;
    columns:          1;
    lines:            5;
    spacing:          5px;
    cycle:            true;
    dynamic:          true;
    layout:           vertical;
    fixed-height:     true;
    fixed-columns:    true;
    scrollbar:        false;
}

element {
    background-color: @accent-dim;
    border:           1px solid;
    border-color:     @border-subtle;
    text-color:       @fg-main;
    border-radius:    8px;
    padding:          9px 14px;
    cursor:           pointer;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    horizontal-align: 0.0;
}

element normal.normal {
    background-color: @accent-dim;
    text-color:       @fg-main;
}

element alternate.normal {
    background-color: @accent-dim;
    text-color:       @fg-main;
}

element selected.normal {
    background-color: @accent;
    text-color:       @selected-fg;
    border:           1px solid;
    border-color:     @accent;
}
