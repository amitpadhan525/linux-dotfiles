/*******************************************************************************
 * ROFI — App Launcher Theme
 * Accent: Neon Teal #00ffb3 — unified with Waybar / Hyprland / Power Menu
 * Rofi 2.0 — uses 8-digit hex (#rrggbbaa) for transparency
 *******************************************************************************/

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               " Apps";
    display-run:                " Run";
    display-filebrowser:        " Files";
    display-window:             " Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    font:                        "JetBrainsMono Nerd Font Bold 12";

    /* ── Colour Tokens ── */
    bg-base:                     #000000ff;    /* opaque background */
    bg-alt:                      #ffffff14;    /* soft white sheen for search bar */
    fg-main:                     #ffffffff;   /* crisp white              */
    fg-dim:                      #888888ff;    /* clean gray               */
    accent:                      #00ffb3ff;    /* neon teal                */
    accent-dim:                  #00ffb30a;    /* teal tint ~4%            */
    accent-mid:                  #00ffb3b3;    /* teal tint ~70% (matching Dunst notification border) */
    border-subtle:               #00ffb333;    /* teal border ~20%         */
    urgent:                      #f38ba8ff;    /* red for urgent           */

    background-color:            transparent;
    text-color:                  @fg-main;
}

window {
    transparency:                "real";
    background-color:            @bg-base;
    border:                      1px solid;
    border-color:                @accent-mid;
    border-radius:               22px;
    width:                       680px;
    location:                    center;
    anchor:                      center;
    x-offset:                    0px;
    y-offset:                    0px;
    cursor:                      "default";
}

mainbox {
    background-color:            transparent;
    children:                    [ "inputbar", "listview" ];
    padding:                     24px;
    spacing:                     16px;
}

inputbar {
    background-color:            @bg-alt;
    border:                      1px solid;
    border-color:                @accent;
    border-radius:               12px;
    padding:                     12px 16px;
    spacing:                     10px;
    children:                    [ "prompt", "entry" ];
    text-color:                  @fg-main;
}

prompt {
    background-color:            transparent;
    text-color:                  @accent;
}

entry {
    background-color:            transparent;
    text-color:                  @fg-main;
    cursor:                      text;
    placeholder:                 "Search…";
    placeholder-color:           @fg-dim;
}

listview {
    background-color:            transparent;
    columns:                     2;
    lines:                       6;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    spacing:                     8px;
    fixed-height:                true;
    fixed-columns:               true;
}

element {
    background-color:            @accent-dim;
    border:                      1px solid;
    border-color:                @border-subtle;
    border-radius:               10px;
    padding:                     10px;
    spacing:                     10px;
    cursor:                      pointer;
    text-color:                  @fg-main;
}

element normal.normal {
    background-color:            @accent-dim;
    text-color:                  @fg-main;
}

element alternate.normal {
    background-color:            @accent-dim;
    text-color:                  @fg-main;
}

element selected.normal {
    background-color:            @accent;
    border-color:                @accent;
    text-color:                  #000000ff;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        32px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
