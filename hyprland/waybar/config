{
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "hyprland/workspaces",
        "network",
        "custom/hotspot",
        "tray"
    ],
    "modules-center": [
        "clock",
        "custom/uptime"
    ],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "battery",
        "custom/battery_notify",
        "custom/power"
    ],
    "custom/uptime": {
        "exec": "python3 /home/amit/.config/waybar/scripts/screen_time.py",
        "interval": 60,
        "format": "  {}",
        "tooltip": false
    },
    "tray": {
        "icon-size": 20,
        "spacing": 10
    },
    "custom/hotspot": {
        "format": "{}",
        "exec": "/home/amit/.config/waybar/scripts/hotspot_status.sh",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/amit/.config/waybar/scripts/hotspot_toggle.sh",
        "tooltip": true
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": " ",
            "2": " ",
            "3": " ",
            "4": " ",
            "5": " ",
            "urgent": " ",
            "active": " ",
            "default": " "
        },
        "sort-by-number": true
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "clock": {
        "format": "\uf017  {:%H:%M   \uf073  %a, %b %d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "interval": 2,
        "format": "\uf2db  {usage}%",
        "tooltip": true
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "memory": {
        "interval": 2,
        "format": "\uf0c9  {percentage}%",
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB"
    },
    "disk": {
        "interval": 30,
        "format": "\uf0a0  {percentage_used}%",
        "path": "/",
        "tooltip": true,
        "tooltip-format": "HDD: {used} / {total}"
    },
    "network": {
        "format-wifi": "  {essid}  {ipaddr}",
        "format-ethernet": "  {ipaddr}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "  Disconnected",
        "format-disabled": "  Disabled",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "/home/amit/.config/waybar/scripts/wifi_menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "{icon}\uf294 {volume}%",
        "format-muted": "\uf026 Muted",
        "format-icons": {
            "headphone": "\uf025",
            "hands-free": "\uf590",
            "headset": "\uf590",
            "phone": "\uf095",
            "portable": "\uf095",
            "car": "\uf1b9",
            "default": [
                "\uf027",
                "\uf028"
            ]
        },
        "scroll-step": 1,
        "on-click": "pavucontrol"
    },
    "custom/power": {
        "format": "\u23fb ",
        "on-click": "/home/amit/.config/waybar/scripts/power_menu.sh",
        "tooltip": false
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "\uf0e7  {capacity}%",
        "format-plugged": "\uf0e7  {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "\uf244",
            "\uf243",
            "\uf242",
            "\uf241",
            "\uf240"
        ]
    },
    "custom/battery_notify": {
        "exec": "/home/amit/.config/waybar/scripts/battery_notify.sh",
        "interval": 30,
        "format": ""
    }
}