{
    "name": "daily",
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [],
    "modules-center": [
        "custom/recording",
        "hyprland/workspaces",
        "custom/clock",
        "network",
        "custom/cpu",
        "custom/temperature",
        "custom/memory",
        "battery"
    ],
    "modules-right": [],
    "custom/recording": {
        "exec": "python3 $HOME/.config/waybar/scripts/recording_status.py",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "on-click": "$HOME/.config/hypr/scripts/screen_record.sh",
        "tooltip": true,
        "signal": 8
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"{name}\" })'",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'",
        "sort-by-number": true
    },
    "custom/clock": {
        "exec": "python3 $HOME/.config/waybar/scripts/custom_clock.py",
        "return-type": "json",
        "interval": 1,
        "on-click": "python3 $HOME/.config/waybar/scripts/custom_clock.py --toggle",
        "tooltip": true,
        "signal": 9
    },
    "custom/temperature": {
        "exec": "$HOME/.config/waybar/scripts/cpu_temp.sh",
        "interval": 5,
        "return-type": "json",
        "tooltip": true
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "  Disconnected",
        "format-disabled": "  Disabled",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "$HOME/.config/waybar/scripts/wifi_menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "custom/cpu": {
        "exec": "$HOME/.config/waybar/scripts/custom_cpu.sh",
        "interval": 3,
        "format": "  {}",
        "return-type": "json",
        "tooltip": true
    },
    "custom/memory": {
        "exec": "$HOME/.config/waybar/scripts/custom_mem.sh",
        "interval": 5,
        "format": "  {}",
        "return-type": "json",
        "tooltip": true
    }
}
