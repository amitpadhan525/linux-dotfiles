{
    "name": "daily",
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 0,
    "modules-left": [],
    "modules-center": [
        "custom/recording",
        "custom/volume_brightness_osd",
        "hyprland/workspaces",
        "clock",
        "network",
        "custom/cpu",
        "custom/temperature",
        "custom/memory",
        "battery"
    ],
    "modules-right": [],
    "custom/recording": {
        "exec": "python3 /home/amit/.config/waybar/scripts/recording_status.py",
        "return-type": "json",
        "format": "{}",
        "interval": 1,
        "on-click": "/home/amit/.config/hypr/scripts/screen_record.sh",
        "tooltip": true,
        "signal": 8
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-number": true,
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
    },
    "custom/volume_brightness_osd": {
        "exec": "python3 /home/amit/.config/waybar/scripts/volume_brightness_osd.py",
        "return-type": "json",
        "format": "{text}"
    },
    "clock": {
        "format": "  {:%I:%M %p}",
        "format-alt": "  {:%d %m %Y}",
        "interval": 1,
        "tooltip-format": "<span color='#cba6f7'><big>{:%A, %d %B %Y}</big></span>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#cba6f7'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'>{}</span>",
                "weeks": "<span color='#6c7086'><b>W{}</b></span>",
                "weekdays": "<span color='#fde047'><b>{}</b></span>",
                "today": "<span color='#00ffb3'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode"
        }
    },
    "custom/temperature": {
        "exec": "/home/amit/.config/waybar/scripts/cpu_temp.sh",
        "interval": 5,
        "return-type": "json",
        "tooltip": true
    },
    "network": {
        "format-wifi": "  {essid}",
        "format-ethernet": "  Connected",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "  Disconnected",
        "format-disabled": "  Disabled",
        "tooltip-format": "{ifname} via {gwaddr}",
        "on-click": "/home/amit/.config/waybar/scripts/wifi_menu.sh",
        "on-click-right": "nm-connection-editor"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon}  {capacity}%",
        "format-charging": "  {capacity}%",
        "format-plugged": "  {capacity}%",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "custom/cpu": {
        "exec": "/home/amit/.config/waybar/scripts/custom_cpu.sh",
        "interval": 3,
        "format": "  {}",
        "return-type": "json",
        "tooltip": true
    },
    "custom/memory": {
        "exec": "/home/amit/.config/waybar/scripts/custom_mem.sh",
        "interval": 5,
        "format": "  {}",
        "return-type": "json",
        "tooltip": true
    }
}
